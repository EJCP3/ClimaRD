# Copia este archivo a .env y ajusta los valores según tu máquina:
#   1. Edita DATABASE_URL con tu usuario, contraseña, puerto y base de datos
#   2. Luego ejecuta: scripts/setup_db.sql (una sola vez)
# Si tu PostgreSQL tiene PostGIS habilitado, también puedes correr lo opcional del script.
DATABASE_URL=postgresql://climard:climard_dev_2026@localhost:5433/climard
MEDIA_UPLOAD_DIR=uploads
MAX_UPLOAD_MB=5